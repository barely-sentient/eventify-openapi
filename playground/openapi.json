  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "required": [
          "id",
          "username",
          "email"
        ],
        "x-entity": "user",
        "x-zod": "z.object({ id: z.string().uuid(), username: z.string().min(3), email: z.string().email() })",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "a3f1c2d4-9b1e-4a7d-8c9e-0f1a2b3c4d5e"
          },
          "username": {
            "type": "string",
            "pattern": "^[a-z0-9_]{3,20}$",
            "example": "ada_love"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "ada@example.com"
          },
          "displayName": {
            "type": "string",
            "example": "Ada Lovelace"
          },
          "avatar": {
            "type": "string",
            "format": "uri",
            "nullable": true,
            "example": "https://cdn.example.com/avatars/ada.jpg"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "editor",
              "viewer"
            ],
            "default": "viewer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BlogPost": {
        "type": "object",
        "required": [
          "id",
          "title",
          "slug",
          "author",
          "content"
        ],
        "x-entity": "blogpost",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "example": "Composing schemas with json-ject"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9-]{3,80}$",
            "example": "composing-schemas-with-json-ject"
          },
          "excerpt": {
            "type": "string",
            "maxLength": 300,
            "example": "How we split a 4k-line OpenAPI file into 20 modules."
          },
          "content": {
            "type": "string",
            "example": "# Hello\nMarkdown body…"
          },
          "author": {
            "$ref": "#/components/schemas/User"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "example": "openapi"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published",
              "archived"
            ],
            "default": "draft"
          },
          "coverImage": {
            "$ref": "#/components/schemas/ImagePost"
          },
          "viewCount": {
            "type": "integer",
            "minimum": 0,
            "example": 4123
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "comments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Comment"
            }
          }
        }
      },
      "Video": {
        "type": "object",
        "required": [
          "id",
          "title",
          "url",
          "duration"
        ],
        "x-entity": "video",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "example": "Intro to JSON composition"
          },
          "description": {
            "type": "string",
            "example": "5-minute walkthrough of @require merging."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "example": "https://cdn.example.com/videos/intro.mp4"
          },
          "thumbnail": {
            "type": "string",
            "format": "uri",
            "example": "https://cdn.example.com/videos/intro.jpg"
          },
          "duration": {
            "type": "integer",
            "minimum": 0,
            "description": "Duration in seconds",
            "example": 312
          },
          "author": {
            "$ref": "#/components/schemas/User"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "views": {
            "type": "integer",
            "minimum": 0,
            "example": 98700
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Comment": {
        "type": "object",
        "required": [
          "id",
          "author",
          "body"
        ],
        "x-entity": "comment",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "body": {
            "type": "string",
            "maxLength": 2000,
            "example": "Great post! The @require trick saved us 800 lines."
          },
          "author": {
            "$ref": "#/components/schemas/User"
          },
          "postId": {
            "type": "string",
            "format": "uuid",
            "description": "Parent BlogPost id"
          },
          "parentCommentId": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "Threaded reply"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "likes": {
            "type": "integer",
            "minimum": 0,
            "example": 12
          }
        }
      },
      "ImagePost": {
        "type": "object",
        "required": [
          "id",
          "imageUrl"
        ],
        "x-entity": "imagepost",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "imageUrl": {
            "type": "string",
            "format": "uri",
            "example": "https://cdn.example.com/photos/123.jpg"
          },
          "caption": {
            "type": "string",
            "maxLength": 500,
            "example": "Sunset over the docs"
          },
          "altText": {
            "type": "string",
