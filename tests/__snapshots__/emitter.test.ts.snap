exports[`emitter emitEntityEventsFile matches snapshot for user 1`] = `
"// Generated by eventify-openapi - do not edit. Changes will be overwritten.
// For custom events create a separate file e.g. user.custom.events.ts and follow:
//   import { Events } from 'eventify-openapi';
//   Events.User.MyCustomEvent = new TypedEvent<[SessionCtx, User], User>();

import { User, UserSchema } from '@api/user';
import { Events, createEntityEvents } from 'eventify-openapi';
import type { SessionCtx } from './ctx.js';

// 6 base events are created with correct signatures:
// - BeforeCreate: TypedEvent<[SessionCtx, User], User> (ctx, entity) => User
// - AfterCreate: TypedEvent<[SessionCtx, User], User> (ctx, entity) => User
// - BeforeUpdate: TypedEvent<[SessionCtx, User, User], User> (ctx, before, after) => User
// - AfterUpdate: TypedEvent<[SessionCtx, User, User], User> (ctx, before, after) => User
// - BeforeDelete: TypedEvent<[SessionCtx, User], User> (ctx, entity) => User
// - AfterDelete: TypedEvent<[SessionCtx, User], User> (ctx, entity) => User
export const UserEvents = createEntityEvents<SessionCtx, User>(UserSchema);

(Events as unknown as Record<string, unknown>).User = UserEvents;

declare module "eventify-openapi" {
  interface EventifyOpenApiEvents {
    User: typeof UserEvents;
  }
  var Events: EventifyOpenApiEvents;
}
"
`;

